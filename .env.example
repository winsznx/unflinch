# Server only. Never prefix these with NEXT_PUBLIC_.
REACTOR_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=

# Public: the anon key only joins broadcast channels; every message is HMAC-signed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public-mode limits (PRD §4.11). PUBLIC_LIVE=0 is the global kill switch.
PUBLIC_LIVE=1
PUBLIC_MAX_SESSION_S=240
PUBLIC_SESSIONS_PER_IP=2
SEED_LOCKED=2026

# Session id served at /runs/canonical once the canonical run is recorded (G10).
CANONICAL_RUN_ID=
